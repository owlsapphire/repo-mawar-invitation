{
  "rewrites": [
    {
      "source": "/rsvp",
      "destination": "https://digiowlinvitation.site/public/rsvp/:query*"
    }
  ],
  "headers": [
    {
      "source": "/rsvp",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.digiowlinvitation.site; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;"
        }
      ]
    }
  ]
}
