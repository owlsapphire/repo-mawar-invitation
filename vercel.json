<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard RSVP Klien</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        html, body { 
            margin: 0; 
            padding: 0; 
            width: 100%; 
            height: 100%; 
            background-color: #fddde6; /* Latar Belakang Tetap Pink Romantis Lu */
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Header Atas Brand Reseller Lu */
        .header-pink-premium {
            background-color: #ffffff;
            border-bottom: 4px solid #1c2033;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 9999;
            box-shadow: 0 4px 0px rgba(28, 32, 51, 0.05);
        }

        .brand-text {
            font-weight: bold;
            font-size: 16px;
            color: #1c2033;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-badge {
            background-color: #fff0f5;
            border: 2px solid #1c2033;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
            color: #1c2033;
        }

        /* Frame Pembungkus Window Brutalism */
        .main-workspace {
            flex: 1;
            width: 100%;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .window-box-pink {
            width: 100%;
            max-width: 1100px; /* Diperlebar biar muat tabel data tamu pas udah login */
            height: 100%;
            background: #ffffff;
            border: 4px solid #1c2033;
            border-radius: 24px;
            box-shadow: 8px 8px 0px #1c2033;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Bar Jendela Atas Warna Pink Cerah */
        .window-top-bar {
            background: #e390ba;
            padding: 12px 20px;
            border-bottom: 4px solid #1c2033;
            color: #1c2033;
            font-weight: bold;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
            text-transform: uppercase;
        }

        .iframe-container-safe {
            flex: 1;
            width: 100%;
            height: 100%;
            background: #ffffff;
        }

        /* Iframe murni biar submit data login bawaan vendor dijamin 100% lancar */
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>

    <!-- 1. Header Atas: Identitas Brand Reseller Lu Tetap Eksis -->
    <div class="header-pink-premium">
        <div class="brand-text">
            <i class="fas fa-heart" style="color: #e390ba;"></i> Henna Wedding Dashboard
        </div>
        <div class="status-badge">
            <i class="fas fa-key"></i> Default Password: 123456
        </div>
    </div>

    <!-- 2. Area Jendela Tempat Menampilkan Sistem Asli DigiOwl -->
    <div class="main-workspace">
        <div class="window-box-pink">
            <div class="window-top-bar">
                <i class="fas fa-database"></i> REALTIME RSVP & UCAPAN TAMU UNDANGAN
            </div>
            <div class="iframe-container-safe">
                <!-- Kita panggil langsung dashboard aslinya disisipi ke dalam frame pink kita -->
                <iframe id="targetIframeDigiowl"></iframe>
            </div>
        </div>
    </div>

    <script>
        // Tangkap parameter ID pengantin otomatis dari link vercel lu (?id=151998) [cite: Evidence: Sustained engagement in over 20 conversations regarding professional marketing strategies, advertising campaigns for HKA Horeca and DigiOwl, and job applications for advertiser roles. Conversation Date: 2025-11 to 2026-05.]
        const urlParams = window.location.search;
        
        // Tembak langsung ke URL Publik milik DigiOwl yang terbukti lancar jaya pas di-submit password
        document.getElementById('targetIframeDigiowl').src = "https://digiowlinvitation.site/public/rsvp/" + urlParams;
    </script>
</body>
</html>
